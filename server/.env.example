# Con la que corre la API (server/app/db.py) y el subproceso
# scripts/analyze_news.py: debe ser el rol restringido "app_runtime" (ver
# db/roles.sql), que solo puede ejecutar las funciones de db/procedures.sql
# -- no tiene ningún permiso directo sobre las tablas.
DATABASE_URL=postgresql://app_runtime:password@localhost:5432/pesca_ilegal

# Rol dueño de las tablas, solo para migraciones y scripts de mantenimiento
# manual (nunca los corre la API): aplicar db/schema.sql, db/procedures.sql y
# db/roles.sql en ese orden, y correr scripts/cargar_incidentes_csv.py o
# scripts/sync_lambayeque.py (sin --json) con esta conexión.
DATABASE_URL_ADMIN=postgresql://postgres:password@localhost:5432/pesca_ilegal

ANTHROPIC_API_KEY=sk-ant-...
GFW_API_TOKEN=...
PORT=8787

# Orígenes permitidos para llamar a la API desde el navegador (separados por
# coma). Por defecto solo el Vite dev server local; en producción, poner el/los
# dominios reales donde se sirve el frontend (server/app/main.py).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave para firmar los tokens de sesión (server/app/auth_dep.py). Generar una
# propia en cada entorno, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# Ejecutable de Python que usa server/app/routes/fuentes.py para lanzar
# scripts/analyze_news.py (por defecto "python"; en algunos sistemas es "python3").
PYTHON_BIN=python
